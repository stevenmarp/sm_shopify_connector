<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_shopify_connector" model="ir.module.category">
        <field name="name">Shopify Connector</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_shopify_connector" model="res.groups.privilege">
        <field name="name">Shopify Connector</field>
        <field name="category_id" ref="module_category_shopify_connector"/>
        <field name="sequence">25</field>
    </record>

    <record id="group_shopify_connector_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_shopify_connector"/>
    </record>

    <record id="group_shopify_connector_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_shopify_connector"/>
        <field name="implied_ids" eval="[(4, ref('group_shopify_connector_user'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_shopify_connector_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_shopify_connector_manager'))]"/>
    </record>

    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_shopify_connector_manager'))]"/>
    </record>
</odoo>
