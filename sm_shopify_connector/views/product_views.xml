<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_product_product_list" model="ir.ui.view">
        <field name="name">product.product.shopify.list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="default_code"/>
                <field name="barcode"/>
                <field name="lst_price"/>
                <field name="shopify_instance_id"/>
                <field name="shopify_variant_gid"/>
                <field name="shopify_last_imported"/>
            </list>
        </field>
    </record>

    <record id="action_shopify_products" model="ir.actions.act_window">
        <field name="name">Shopify Products</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('shopify_instance_id', '!=', False)]</field>
        <field name="view_id" ref="view_shopify_product_product_list"/>
    </record>
</odoo>
