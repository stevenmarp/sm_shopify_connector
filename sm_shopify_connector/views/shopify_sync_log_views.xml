<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_sync_log_list" model="ir.ui.view">
        <field name="name">shopify.sync.log.list</field>
        <field name="model">shopify.sync.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0">
                <field name="create_date"/>
                <field name="instance_id"/>
                <field name="operation"/>
                <field name="state" widget="badge"/>
                <field name="records_processed"/>
                <field name="message"/>
            </tree>
        </field>
    </record>

    <record id="view_shopify_sync_log_form" model="ir.ui.view">
        <field name="name">shopify.sync.log.form</field>
        <field name="model">shopify.sync.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <field name="instance_id"/>
                        <field name="operation"/>
                        <field name="state"/>
                        <field name="records_processed"/>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">shopify.sync.log</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
