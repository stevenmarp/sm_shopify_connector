<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_instance_list" model="ir.ui.view">
        <field name="name">shopify.instance.list</field>
        <field name="model">shopify.instance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="shop_url"/>
                <field name="state" widget="badge"/>
                <field name="product_count"/>
                <field name="customer_count"/>
                <field name="order_count"/>
                <field name="last_product_import"/>
                <field name="last_order_import"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_instance_form" model="ir.ui.view">
        <field name="name">shopify.instance.form</field>
        <field name="model">shopify.instance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/>
                    <button name="action_refresh_access_token" type="object" string="Fetch Token"/>
                    <button name="action_import_products" type="object" string="Import Products"/>
                    <button name="action_import_customers" type="object" string="Import Customers"/>
                    <button name="action_import_orders" type="object" string="Import Orders"/>
                    <button name="action_import_all" type="object" string="Import All" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cube">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                        <button name="action_view_customers" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="customer_count" widget="statinfo" string="Customers"/>
                        </button>
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="sync_log_count" widget="statinfo" string="Logs"/>
                        </button>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="name"/>
                            <field name="shop_url" placeholder="your-store.myshopify.com"/>
                            <field name="auth_method"/>
                            <field name="client_id" invisible="auth_method != 'client_credentials'"/>
                            <field name="client_secret" password="True" invisible="auth_method != 'client_credentials'"/>
                            <field name="access_token" password="True" invisible="auth_method != 'access_token'"/>
                            <field name="token_expires_at" readonly="1" invisible="auth_method != 'client_credentials'"/>
                            <field name="token_scope" readonly="1" invisible="auth_method != 'client_credentials'"/>
                            <field name="api_version"/>
                            <field name="active"/>
                        </group>
                        <group string="Odoo Mapping">
                            <field name="company_id"/>
                            <field name="warehouse_id"/>
                            <field name="pricelist_id"/>
                            <field name="import_order_state"/>
                        </group>
                    </group>
                    <group string="Import Limits">
                        <group>
                            <field name="product_limit"/>
                            <field name="customer_limit"/>
                            <field name="order_limit"/>
                        </group>
                        <group>
                            <field name="last_product_import" readonly="1"/>
                            <field name="last_customer_import" readonly="1"/>
                            <field name="last_order_import" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_instance" model="ir.actions.act_window">
        <field name="name">Shopify Stores</field>
        <field name="res_model">shopify.instance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
